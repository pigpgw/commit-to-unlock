{
  "name": "commit-to-unlock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "android:dogfood": "bash scripts/android-dogfood-install.sh",
    "android:dogfood:export": "bash scripts/android-dogfood-export.sh",
